# ⚡ GAME PLAY — служба бота (опрос Telegram).
#
# Установка на сервере:
#   cp /var/www/gameplay/gameplay-bot.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now gameplay-bot
#
# Посмотреть, что делает:
#   systemctl status gameplay-bot
#   journalctl -u gameplay-bot -f

[Unit]
Description=GAME PLAY Telegram bot (long polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/gameplay
ExecStart=/usr/bin/php /var/www/gameplay/poller.php

# Связь с Telegram нестабильна — служба должна подниматься сама.
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gameplay-bot

# Доступ только к своему каталогу
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/gameplay

[Install]
WantedBy=multi-user.target
